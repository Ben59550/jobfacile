# Copiez ce fichier en .env puis remplissez les valeurs. Ne publiez jamais le fichier .env.
PORT=3000
# URL publique du site (liens dans les e-mails)
PUBLIC_URL=http://localhost:3000

# IA (https://console.groq.com/keys)
GROQ_API_KEY=
GEMINI_API_KEY=

# E-mails (Gmail + mot de passe d'application : https://myaccount.google.com/apppasswords)
EMAIL_USER=
EMAIL_PASS=

# Offres : France Travail (https://francetravail.io), Adzuna (https://developer.adzuna.com), JSearch (RapidAPI)
FT_CLIENT_ID=
FT_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# Connexion avec Google : identifiant client OAuth « Application Web »
# (https://console.cloud.google.com/apis/credentials) avec l'origine JavaScript autorisée = votre URL publique
GOOGLE_CLIENT_ID=

# Voix naturelle du recruteur (entretien vocal) : https://elevenlabs.io → Profil → API Keys
# Sans clé, le navigateur utilise sa propre voix. Voix française : copiez son « Voice ID » depuis la bibliothèque de voix.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Administrateurs (modération du forum, des offres recruteurs et des messages signalés), séparés par des virgules
ADMIN_EMAILS=

# Application Android (voir mobile/README.md), une fois le site en ligne
ANDROID_PACKAGE=
ANDROID_SHA256=

# Une fois en ligne derrière un hébergeur ou un proxy (Nginx, Render…) : nombre d'intermédiaires, en général 1
TRUST_PROXY=

# Sauvegardes : une copie de la base par jour dans data/backups (14 gardées).
# Dossier supplémentaire conseillé, hors du serveur (ex. C:/Users/vous/OneDrive/JobFacile-sauvegardes)
BACKUP_DIR=
